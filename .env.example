# --- Corpus ---------------------------------------------------------------
# The repo moved orgs; tiangolo/fastapi is now a 301 to this. The client
# follows redirects, so the old name still works -- but the canonical one keeps
# `resolved_sha` attributable to a repo that still exists under that path.
CORPUS_REPO=fastapi/fastapi
# Symbolic ref. Ingest resolves it to a commit SHA and records that SHA on the
# ingest_runs row -- TRD §5.1 and §14.2 both require a *pinned* revision, and
# a moving branch is not one.
CORPUS_REF=master

# Two window floors, because the two substrates want opposite things.
# INGEST_SINCE bounds PRs and commits: the facts layer answers "what shipped
# last month" and wants recency, and PRs cost three API calls each (~1,100 PRs
# since 2025 -> ~3,300 calls).
INGEST_SINCE=2025-01-01
# INGEST_ISSUES_SINCE bounds issues -- blank means full history. Decision
# archaeology (PRD classes 5-6) lives in the archive: FastAPI has 3,541 closed
# issues but only 89 created since 2025, because support traffic moved to
# Discussions. Windowing issues the same way would starve 20 golden questions.
INGEST_ISSUES_SINCE=

# Read-only access to public repos is all ingest needs; it never writes
# (PRD §2). Prefer a fine-grained token with no permissions over the classic
# `public_repo` scope, which grants *write* access to every public repo.
GITHUB_TOKEN=
# Curated area name -> path glob mapping (TRD §5.5)
AREAS_FILE=./areas.yaml

# --- Storage --------------------------------------------------------------
DATABASE_URL=postgresql://askstack:askstack@localhost:5432/askstack

# --- Models ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high
# extraction / consolidation / judge run at low effort
BATCH_EFFORT=low
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Observability --------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=dev-secret-change-me
LANGFUSE_SALT=dev-salt-change-me

# --- Ablation flags (see PRD §8.4) ---------------------------------------
HYBRID_ENABLED=true
MEMORY_ENABLED=true
# semantic | native | full
TOOL_RETRIEVAL_MODE=semantic
TOOL_RETRIEVAL_K=5
# 0 = real tools only; >0 pads the catalog with synthetic defs for the scaling sweep
TOOL_CATALOG_SIZE=0
MEMORY_TOKEN_BUDGET=2000
RETRIEVAL_TOP_K=10
TOOL_SIMILARITY_FLOOR=0.25

# Kill switch for the structured facts path, NOT an ablation axis --
# with it off, question classes 1-4 are unanswerable (TRD §6.4)
STRUCTURED_ENABLED=true
