# --- Corpus ---------------------------------------------------------------
CORPUS_REPO=tiangolo/fastapi
CORPUS_REF=master
GITHUB_TOKEN=
# Curated area name -> path glob mapping (TRD §5.5)
AREAS_FILE=./areas.yaml

# --- Storage --------------------------------------------------------------
DATABASE_URL=postgresql://askstack:askstack@localhost:5432/askstack

# --- Models ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high
# extraction / consolidation / judge run at low effort
BATCH_EFFORT=low
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Observability --------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=dev-secret-change-me
LANGFUSE_SALT=dev-salt-change-me

# --- Ablation flags (see PRD §8.4) ---------------------------------------
HYBRID_ENABLED=true
MEMORY_ENABLED=true
# semantic | native | full
TOOL_RETRIEVAL_MODE=semantic
TOOL_RETRIEVAL_K=5
# 0 = real tools only; >0 pads the catalog with synthetic defs for the scaling sweep
TOOL_CATALOG_SIZE=0
MEMORY_TOKEN_BUDGET=2000
RETRIEVAL_TOP_K=10
TOOL_SIMILARITY_FLOOR=0.25

# Kill switch for the structured facts path, NOT an ablation axis --
# with it off, question classes 1-4 are unanswerable (TRD §6.4)
STRUCTURED_ENABLED=true
